# ─────────────────────────────────────────────
# Relay – Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── PostgreSQL / Supabase ──────────────────────────────────────────────────────
# Full connection string for your Supabase PostgreSQL database.
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# OpenAI model to use. Defaults to gpt-4o-mini if not set.
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# Custom system message for the AI agent (optional)
AGENT_SYSTEM_MESSAGE=You are Relay, a helpful and friendly AI assistant. Answer questions clearly and concisely.

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the Go backend HTTP server (default: 8080)
PORT=8080

# Set to "release" in production to disable debug logging
GIN_MODE=debug

# Comma-separated list of allowed CORS origins. Use * to allow all.
# Example: https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Backend API base URL (used by the React frontend)
# In production, set this to your deployed backend URL.
VITE_API_URL=http://localhost:8080
